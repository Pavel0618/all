# Скопируйте в .env и заполните (или задайте такие же переменные в GitHub → Settings → Variables без префикса VITE_)
# Комиссия сервиса: 50 = 0.5% с каждой сделки
VITE_FEE_BPS=50
# Куда приходит комиссия со сделок на Solana (в SOL)
VITE_FEE_SOLANA_WALLET=
# Куда приходит комиссия со сделок в Ethereum / Base / BNB / Arbitrum (в ETH/BNB)
VITE_FEE_EVM_WALLET=
# Telegram: username бота без @ и короткое имя Mini App — для ссылок «Поделиться»
VITE_TG_BOT=
VITE_TG_APP=
# Адрес сервера Twitter-анализа (Cloudflare Worker). При публикации через GitHub Actions подставляется сам
VITE_SIGNALS_URL=
# Имя интегратора в LI.FI Portal — комиссия на сделках через резервный агрегатор LI.FI (необязательно)
VITE_LIFI_INTEGRATOR=
