{
  "name": "gem-radar",
  "private": true,
  "version": "1.0.0",
  "description": "X-Gem Radar — инструмент для поиска и покупки мемкоинов по методике «X-гемы через Twitter»",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "e2e": "vite build && node e2e/smoke.cjs"
  },
  "dependencies": {
    "@solana/wallet-adapter-base": "^0.9.28",
    "@solana/wallet-adapter-react": "^0.15.40",
    "@solana/web3.js": "^1.99.0",
    "buffer": "^6.0.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "viem": "^2.57.3"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright": "^1.63.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
